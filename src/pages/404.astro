---
import Base from '../layouts/Base.astro';
import { ssrRender, notFoundHTML } from '../client/app.js';
const { chrome } = ssrRender('/');
---
<Base title="Page not found — Weatherhaven" description="We couldn’t find that page." path="/404/" chrome={chrome} noindex={true}>
  <Fragment set:html={notFoundHTML()} />
</Base>
