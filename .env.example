# Copy to .env (or set in Vercel → Project → Settings → Environment Variables)
# Public site URL (canonical links, sitemap, Open Graph)
SITE_URL=https://www.weatherhaven.com
# 1 = keep search engines out (preview deployments). Remove for launch.
PUBLIC_NOINDEX=1
# Quote form delivery — pick one. With neither set, requests are logged only.
RESEND_API_KEY=
CONTACT_TO=sales@example.com
CONTACT_FROM=Weatherhaven website <website@example.com>
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Analytics (optional): plausible | vercel | none
PUBLIC_ANALYTICS=none
PUBLIC_PLAUSIBLE_DOMAIN=
# Error monitoring (optional)
PUBLIC_SENTRY_DSN=
